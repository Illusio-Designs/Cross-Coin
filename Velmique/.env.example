# Velmique — frontend env
# Copy to .env.local and fill in values for local dev.

# Public API base — same backend as Crosscoin / Knitwink
NEXT_PUBLIC_API_URL=https://api.crosscoin.in
API_URL=https://api.crosscoin.in

# Tells the backend which brand's data to return (sliders, products, etc.)
NEXT_PUBLIC_BRAND_NAME=velmique

# ImageKit CDN base for resolving relative product/wishlist image paths
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/wp2oatzmf

# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_pBysvwx4mlXcuM
NEXT_PUBLIC_MAGIC_CHECKOUT_ENABLED=true

# Optional: instant discount shown on prepaid orders (₹). 0 disables the nudge.
NEXT_PUBLIC_PREPAID_INSTANT_DISCOUNT_INR=0
