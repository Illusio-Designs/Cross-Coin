  "keywords": [
    "e-commerce",
    "online shopping",
    "store",
    "products",
    "cart",
    "checkout",
    "payment",
    "shipping"
  ],
  "author": "Riya Lunagariya",
  "license": "ISC",
  "email": "info@illusiodesigns.agency",
  "website": "https://www.illusiodesigns.agency",
