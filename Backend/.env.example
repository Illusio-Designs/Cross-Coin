# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_DATABASE=crosscoin
DB_DIALECT=mysql

# Server Configuration
PORT=5000
NODE_ENV=production

# Security
JWT_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# URLs
API_URL=https://api.crosscoin.in
BACKEND_URL=https://api.crosscoin.in
FRONTEND_URL=https://crosscoin.in
BASE_URL=https://api.crosscoin.in

# Redis Configuration (Live Server)
REDIS_HOST=127.0.0.1
REDIS_PORT=35399
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:35399/0

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ImageKit Configuration
IMAGEKIT_PUBLIC_KEY=CHANGE_ME
IMAGEKIT_PRIVATE_KEY=CHANGE_ME
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Google Analytics (Measurement Protocol)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=CHANGE_ME

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_API_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME

# MSG91 OTP Configuration
MSG91_AUTH_KEY=CHANGE_ME

# Data Encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-char hex string.
DATA_ENCRYPTION_KEY=CHANGE_ME


# ── Courier webhook auth (iThink → /api/orders/shipping/webhook) ─────────────
# iThink's webhook panel can only attach a static credential. Pick a long
# random string, enter it as the Bearer Token in iThink's panel, and set the
# SAME value here. Deliveries without a matching token are still accepted
# (marked unverified) until WEBHOOK_REQUIRE_SIGNATURE=true is set.
ITHINK_WEBHOOK_TOKEN=
# Set to true once the token above is configured to reject unauthenticated
# webhook posts entirely.
WEBHOOK_REQUIRE_SIGNATURE=false

# One-time admin bootstrap for a FRESH database (setup only creates it when no
# admin exists). Leave blank in production once an admin account exists.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
