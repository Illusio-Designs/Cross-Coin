# iThink API Test Credentials
# Copy this file to Backend/.env.test and fill in real values.
# Never commit Backend/.env.test — it contains live API keys.

# Required
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=

# Environment: "production" or "staging" (default: staging)
ITHINK_ENVIRONMENT=production

# Pickup warehouse to verify (required for warehouse + order tests)
ITHINK_PICKUP_ADDRESS_ID=
ITHINK_RETURN_ADDRESS_ID=

# Warehouse pincode and a sample destination for serviceability + rates
ITHINK_WAREHOUSE_PINCODE=363641
TEST_DESTINATION_PINCODE=110001

# Optional: force a specific courier (delhivery / bluedart / xpressbees / ecom / ekart / fedex).
# Leave blank to let iThink auto-pick.
ITHINK_DEFAULT_LOGISTICS=

# Set to "true" to actually POST /order/add.json (creates a real shipment with a TEST-… reference).
# Default is false so the test is read-only.
TEST_CREATE_ORDER=false
